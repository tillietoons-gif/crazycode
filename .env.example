# LLM provider configuration
# Copy to .env and fill in your values, or export as environment variables.

# API key for your LLM provider
PYCODE_API_KEY=

# Base URL for OpenAI-compatible API (default: https://api.openai.com/v1)
PYCODE_API_BASE=

# Model name (default: gpt-4o)
PYCODE_MODEL=

# Sampling temperature (optional, default: 0.3)
# PYCODE_TEMPERATURE=0.3

# Max response tokens (optional, default: 8192)
# PYCODE_MAX_TOKENS=8192

# Path to a file with extra system prompt instructions (optional)
# PYCODE_SYSTEM_PROMPT_FILE=CLAUDE.md
