# LLM provider configuration
# Copy to .env and fill in your values, or export as environment variables.

# API key for your LLM provider
PYCODE_API_KEY=

# Base URL for OpenAI-compatible API (default: https://api.venice.ai/api/v1)
# For OpenAI: https://api.openai.com/v1
PYCODE_API_BASE=https://api.venice.ai/api/v1

# Model name (default: deepseek-v4-1-flash)
# Venice options: deepseek-v4-1-flash, deepseek-v4-flash, claude-sonnet-4-5, openai-gpt-54, minimax-m3-preview
PYCODE_MODEL=deepseek-v4-1-flash

# Sampling temperature (optional, default: 0.3)
# PYCODE_TEMPERATURE=0.3

# Max response tokens (optional, default: 8192)
# PYCODE_MAX_TOKENS=8192

# Path to a file with extra system prompt instructions (optional)
# PYCODE_SYSTEM_PROMPT_FILE=CLAUDE.md
